# MediaMTX 镜像
MEDIAMTX_IMAGE_TAG=1

# MediaMTX Control API（仅限容器网络访问）
MTX_API=yes
MTX_APIADDRESS=:9997

# MediaMTX WebRTC / WHEP
MTX_WEBRTC=yes
MTX_WEBRTCADDRESS=:8889
MTX_WEBRTCLOCALUDPADDRESS=:8189

# 浏览器可访问的宿主机 IP 或 DNS 名称，多个地址使用逗号分隔。
# 需要从局域网内的其他设备访问时，请替换或补充此配置。
MTX_WEBRTCADDITIONALHOSTS=127.0.0.1

# 宿主机端口
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_WEBRTC_UDP_PORT=8189

# FastAPI 通过 Compose 服务名访问 MediaMTX。
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_API_TIMEOUT=5

# FastAPI 返回给浏览器的公开访问地址。
PUBLIC_WEBRTC_BASE_URL=http://localhost:8889

# Stream Gateway 对外端口、日志级别和允许跨域访问的前端地址。
STREAM_GATEWAY_PORT=8000
STREAM_GATEWAY_LOG_LEVEL=info
STREAM_GATEWAY_CORS_ORIGINS=http://localhost:5173

# 前端访问后端的 API 基础地址。
VITE_API_BASE_URL=http://localhost:8000/api/v1
