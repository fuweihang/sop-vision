# PostgreSQL 镜像和初始化配置。首次部署前请修改示例密码。
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_DB=sop_vision
POSTGRES_USER=sop_vision
POSTGRES_PASSWORD=sop_vision

# PostgreSQL 发布到宿主机端口，供本地开发和管理工具连接。
# 当前 Compose 未限制监听地址；共享或生产环境应通过防火墙或 Compose 端口绑定收紧访问。
POSTGRES_HOST_PORT=5432

# Backend 通过 Compose 服务名访问 PostgreSQL。
# 修改上面的数据库名、用户或密码时，需要同步修改此连接串。
DATABASE_URL=postgresql+psycopg://sop_vision:sop_vision@postgres:5432/sop_vision

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=10
DATABASE_ECHO=false

# Redis 保存运行时状态、实时消息和短期快照，不承担正式配置持久化。
REDIS_IMAGE_TAG=7-alpine

# 宿主机端口只由 compose.dev.yaml 发布，供本地开发和测试使用。
# 当前 override 未限制监听地址；不应直接用于不可信网络。
REDIS_HOST_PORT=6379

# 为 Backend 与未来 Detector 预留的容器内地址；当前应用代码尚未创建 Redis Client。
REDIS_URL=redis://redis:6379/0

# MediaMTX 镜像精确版本；升级前必须同步验证 OpenAPI、Fixture 和契约测试。
MEDIAMTX_IMAGE_TAG=1.20.1

# MediaMTX Control API。基础 Compose 只在容器网络暴露；compose.dev.yaml 会额外发布到宿主机。
MTX_API=yes

# MediaMTX WebRTC / WHEP
MTX_WEBRTC=yes

# 浏览器可访问的宿主机 IP 或 DNS 名称，多个地址使用逗号分隔。
# 需要从局域网内的其他设备访问时，请替换或补充此配置。
MTX_WEBRTCADDITIONALHOSTS=127.0.0.1

# 仅由 compose.dev.yaml 使用，并固定绑定宿主机 127.0.0.1。
MEDIAMTX_API_HOST_PORT=9997

# 宿主机端口
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_WEBRTC_UDP_PORT=8189

# FastAPI 通过 Compose 服务名访问 MediaMTX。
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_API_TIMEOUT=5

# 为 Cameras Playback 切片预留的浏览器公开地址；当前占位 handler 尚未使用。
PUBLIC_WEBRTC_BASE_URL=http://localhost:8889

# Backend 对外端口、日志级别和允许跨域访问的前端地址。
BACKEND_PORT=3001
BACKEND_LOG_LEVEL=info
BACKEND_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 前端访问 Backend 的 API 基础地址。该值在镜像构建时写入静态产物，修改后需要重新构建前端镜像。
FRONTEND_API_BASE_URL=http://localhost:3001/api/v1

# 前端 Nginx 在宿主机上的绑定地址和访问端口。
# 仅允许本机访问时可将绑定地址改为 127.0.0.1。
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=8000
