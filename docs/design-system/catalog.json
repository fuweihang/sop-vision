{
  "$schemaVersion": "3.0.0",
  "name": "SOP Vision Design System",
  "status": "shadcn-aligned",
  "baseline": {
    "viewport": {
      "width": 1280,
      "height": 720,
      "devicePixelRatio": 1
    },
    "theme": "light",
    "updatedAt": "2026-08-19"
  },
  "implementation": {
    "framework": "React + Vite",
    "router": "TanStack Router",
    "componentDistribution": "shadcn/ui",
    "style": "base-nova",
    "primitiveLibrary": "@base-ui/react",
    "iconLibrary": "hugeicons",
    "cssVariables": true,
    "menuColor": "default",
    "menuAccent": "subtle"
  },
  "entrypoints": {
    "human": "README.md",
    "agents": "agent-guidelines.md",
    "evidence": "evidence/manifest.json"
  },
  "runtimeSources": {
    "configuration": "../../frontend/components.json",
    "theme": "../../frontend/src/index.css",
    "components": "../../frontend/src/components/ui",
    "mobileHook": "../../frontend/src/hooks/use-mobile.ts",
    "router": "../../frontend/src/lib/router.ts",
    "prototype": "../prototype/v1.0.html"
  },
  "tokens": {
    "runtimeThemeSnapshot": "tokens/runtime-theme.tokens.json",
    "layout": "tokens/layout.tokens.json"
  },
  "specifications": {
    "foundations": "specs/foundations.md",
    "components": "specs/components.yaml",
    "layout": "specs/layout.yaml",
    "pagePatterns": "specs/page-patterns.md",
    "interactionAccessibility": "specs/interaction-accessibility.md"
  },
  "ownership": {
    "componentGeometryAndPrimitiveBehavior": "frontend runtime source",
    "visualPrinciples": "specs/foundations.md",
    "shellBreakpointsAndGrid": "specs/layout.yaml",
    "routesAndPageComposition": "specs/page-patterns.md",
    "interactionAndAccessibility": "specs/interaction-accessibility.md",
    "projectComponentUsage": "specs/components.yaml"
  },
  "sourceOfTruthOrder": [
    "user requirements",
    "frontend shadcn configuration, runtime theme, and generated UI source",
    "prototype layout, information architecture, and business flows",
    "design-system decisions",
    "repository evidence"
  ],
  "prototype": {
    "path": "../prototype/v1.0.html",
    "authoritativeFor": [
      "layout intent",
      "responsive intent",
      "business flows"
    ],
    "notAuthoritativeFor": [
      "React structure",
      "primitive behavior",
      "focus management",
      "routing implementation",
      "icons"
    ]
  }
}
