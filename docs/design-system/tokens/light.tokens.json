{
  "$description": "Light theme mapping observed at the 1280 × 720 dashboard baseline.",
  "theme": {
    "color": {
      "$type": "color",
      "background": {
        "page": { "$value": "{color.neutral.50}" },
        "surface": { "$value": "{color.white}" },
        "subtle": { "$value": "{color.neutral.50}" },
        "active": { "$value": "{color.neutral.200}" }
      },
      "text": {
        "primary": { "$value": "{color.neutral.1000}" },
        "secondary": { "$value": "{color.neutral.900}" },
        "muted": { "$value": "{color.neutral.700}" },
        "inverse": { "$value": "{color.white}" },
        "link": { "$value": "{color.blue.800}" }
      },
      "border": {
        "default": { "$value": "{color.neutral.200}" },
        "strong": { "$value": "{color.neutral.500}" }
      },
      "action": {
        "primaryBackground": { "$value": "{color.transparent}" },
        "primaryBackgroundHover": { "$value": "{color.blue.100}" },
        "primaryForeground": { "$value": "{color.blue.800}" },
        "primaryBorder": { "$value": "{color.blue.800}" },
        "accent": { "$value": "{color.blue.800}" },
        "focus": { "$value": "{color.blue.700}" }
      },
      "status": {
        "info": { "$value": "{color.blue.700}" },
        "success": { "$value": "{color.green.700}" },
        "warning": { "$value": "{color.amber.700}" },
        "danger": { "$value": "{color.red.700}" }
      },
      "badge": {
        "foreground": {
          "info": { "$value": "{color.blue.800}" },
          "success": { "$value": "{color.green.900}" },
          "warning": { "$value": "{color.amber.900}" },
          "danger": { "$value": "{color.red.900}" }
        }
      }
    },
    "shadow": {
      "$type": "shadow",
      "surface": { "$value": "{shadow.border}" },
      "controlFocus": { "$value": "{shadow.focusNeutral}" },
      "keyboardFocus": { "$value": "{shadow.focusBlue}" },
      "popover": { "$value": "{shadow.menu}" },
      "modal": { "$value": "{shadow.modal}" }
    }
  }
}
