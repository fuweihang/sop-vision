{
  "$description": "Theme-independent semantic contract. Merge with primitives and one theme file before resolving aliases.",
  "semantic": {
    "color": {
      "$type": "color",
      "background": {
        "page": { "$value": "{theme.color.background.page}" },
        "surface": { "$value": "{theme.color.background.surface}" },
        "subtle": { "$value": "{theme.color.background.subtle}" },
        "active": { "$value": "{theme.color.background.active}" }
      },
      "text": {
        "primary": { "$value": "{theme.color.text.primary}" },
        "secondary": { "$value": "{theme.color.text.secondary}" },
        "muted": { "$value": "{theme.color.text.muted}" },
        "inverse": { "$value": "{theme.color.text.inverse}" },
        "link": { "$value": "{theme.color.text.link}" }
      },
      "border": {
        "default": { "$value": "{theme.color.border.default}" },
        "strong": { "$value": "{theme.color.border.strong}" }
      },
      "action": {
        "primary": { "$value": "{theme.color.action.primary}" },
        "primaryHover": { "$value": "{theme.color.action.primaryHover}" },
        "primaryText": { "$value": "{theme.color.action.primaryText}" },
        "focus": { "$value": "{theme.color.action.focus}" }
      },
      "status": {
        "info": { "$value": "{theme.color.status.info}" },
        "success": { "$value": "{theme.color.status.success}" },
        "warning": { "$value": "{theme.color.status.warning}" },
        "danger": { "$value": "{theme.color.status.danger}" }
      }
    },
    "space": {
      "$type": "dimension",
      "inlineCompact": { "$value": "{space.2}" },
      "inline": { "$value": "{space.3}" },
      "component": { "$value": "{space.4}" },
      "card": { "$value": "{space.5}" },
      "page": { "$value": "{space.6}" },
      "section": { "$value": "{space.8}" },
      "pageWide": { "$value": "{space.12}" }
    },
    "radius": {
      "$type": "dimension",
      "control": { "$value": "{radius.medium}" },
      "card": { "$value": "{radius.medium}" },
      "popover": { "$value": "{radius.popover}" },
      "badge": { "$value": "{radius.pill}" }
    },
    "size": {
      "$type": "dimension",
      "controlSmall": { "$value": "{size.control.small}" },
      "controlMedium": { "$value": "{size.control.medium}" },
      "controlLarge": { "$value": "{size.control.large}" },
      "icon": { "$value": "{size.icon.medium}" },
      "sidebar": { "$value": "{size.sidebar}" },
      "header": { "$value": "{size.header}" }
    },
    "typography": {
      "body": {
        "fontFamily": { "$type": "fontFamily", "$value": "{font.family.sans}" },
        "fontSize": { "$type": "dimension", "$value": "{font.size.body}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{font.weight.regular}" },
        "lineHeight": { "$type": "dimension", "$value": "{font.lineHeight.compact}" }
      },
      "control": {
        "fontFamily": { "$type": "fontFamily", "$value": "{font.family.sans}" },
        "fontSize": { "$type": "dimension", "$value": "{font.size.body}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },
        "lineHeight": { "$type": "dimension", "$value": "{font.lineHeight.compact}" }
      },
      "heading": {
        "fontFamily": { "$type": "fontFamily", "$value": "{font.family.sans}" },
        "fontSize": { "$type": "dimension", "$value": "{font.size.heading}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" },
        "lineHeight": { "$type": "dimension", "$value": "{font.lineHeight.heading}" },
        "letterSpacing": { "$type": "dimension", "$value": "{font.letterSpacing.heading}" }
      }
    },
    "shadow": {
      "$type": "shadow",
      "surface": { "$value": "{theme.shadow.surface}" },
      "controlFocus": { "$value": "{theme.shadow.controlFocus}" },
      "keyboardFocus": { "$value": "{theme.shadow.keyboardFocus}" },
      "popover": { "$value": "{theme.shadow.popover}" },
      "modal": { "$value": "{theme.shadow.modal}" }
    },
    "motion": {
      "controlDuration": { "$type": "duration", "$value": "{motion.duration.control}" },
      "popoverDuration": { "$type": "duration", "$value": "{motion.duration.popover}" },
      "standardEasing": { "$type": "cubicBezier", "$value": "{motion.easing.standard}" },
      "swiftEasing": { "$type": "cubicBezier", "$value": "{motion.easing.swift}" }
    }
  }
}

