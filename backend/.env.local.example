# 宿主机 Backend 连接 Compose PostgreSQL。
DATABASE_URL=postgresql+psycopg://sop_vision:sop_vision@127.0.0.1:5432/sop_vision

# 仅供会创建/回滚数据库结构的 PostgreSQL 集成测试使用。
# 测试拒绝复用 DATABASE_URL，且只接受以 _test 结尾的独立数据库名。
TEST_DATABASE_URL=postgresql+psycopg://sop_vision:sop_vision@127.0.0.1:5432/sop_vision_test

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=10
DATABASE_ECHO=false

# 为后续 Redis 接入预留；当前 Backend Settings/Client 尚未读取该变量。
REDIS_URL=redis://127.0.0.1:6379/0

# 宿主机 Backend 连接 Compose MediaMTX Control API。
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_API_TIMEOUT=5
MEDIA_RECONCILIATION_INTERVAL_SECONDS=30
MEDIA_RECONCILIATION_MAX_BACKOFF_SECONDS=300

# 为 Cameras Playback 切片预留；当前占位 handler 尚未使用。
PUBLIC_WEBRTC_BASE_URL=http://127.0.0.1:8889
BACKEND_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# 本地开发可输出应用 DEBUG；console 按 TZ 输出级别固定带颜色的地区时间单行格式。
BACKEND_LOG_LEVEL=debug
BACKEND_LOG_FORMAT=console
TZ=Asia/Shanghai
