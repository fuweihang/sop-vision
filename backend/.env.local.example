# 宿主机 Backend 连接 Compose PostgreSQL。
DATABASE_URL=postgresql+psycopg://sop_vision:sop_vision@127.0.0.1:5432/sop_vision

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=10
DATABASE_ECHO=false

# 宿主机 Backend 连接 Compose Redis。
REDIS_URL=redis://127.0.0.1:6379/0

# 宿主机 Backend 连接 Compose MediaMTX Control API。
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_API_TIMEOUT=5

PUBLIC_WEBRTC_BASE_URL=http://127.0.0.1:8889
BACKEND_CORS_ORIGINS=http://127.0.0.1:8000

# Uvicorn 自己读取，不属于 Pydantic Settings。
UVICORN_LOG_LEVEL=debug
